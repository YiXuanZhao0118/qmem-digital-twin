# Normalise line endings to LF in the repo, regardless of the
# committer's OS. On Windows checkouts that have core.autocrlf=true
# the working tree gets CRLF; the index stays LF, so `git diff` no
# longer fires the "LF will be replaced by CRLF the next time Git
# touches it" warning every time a file is staged.
#
# Anything Windows-native (PowerShell, batch, cmd) keeps CRLF so the
# OS shells can execute it directly.
#
# Binary file types are listed explicitly so Git treats them as
# byte-streams (no text munging, sensible diff/merge handling).
#
# After committing this file, run once to renormalise existing files:
#   git add --renormalize .
#   git commit -m "Renormalise line endings via .gitattributes"

* text=auto eol=lf

# Windows-only shell scripts
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Source code (explicit LF — also lets Git diff treat them as text)
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.py        text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.svg       text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf

# Binary — never touch line endings
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.pdf       binary
*.stl       binary
*.glb       binary
*.gltf      binary
*.obj       binary
*.step      binary
*.stp       binary
*.sldprt    binary
*.dxf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.7z        binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.mp3       binary
*.mp4       binary
*.wav       binary

# Generated / vendored — don't show in diffs by default
package-lock.json   linguist-generated=true
